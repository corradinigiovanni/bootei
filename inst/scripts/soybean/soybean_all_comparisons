df_chi2  <- res$df_chi2

# ---- build long df (p_perm vs p_bootei), keep finite ----
mk_long <- function(df, test_name) {
  df %>%
    transmute(
      test = test_name,
      p_perm   = as.numeric(p_perm),
      p_bootei = as.numeric(p_bootei)
    ) %>%
    pivot_longer(cols = c(p_perm, p_bootei), names_to = "method", values_to = "p") %>%
    dplyr::filter(is.finite(p)) %>%
    dplyr::mutate(
      method = recode(method, p_perm = "Permutation", p_bootei = "BOOTEI"),
      method = factor(method, levels = c("Permutation", "BOOTEI")),
      test   = factor(test, levels = c("Welch t-test", "Chi-square"))
    )
}

p_long <- bind_rows(
  mk_long(df_welch, "Welch t-test"),
  mk_long(df_chi2,  "Chi-square")
)

# ---- 4 boxplots: linear + log scale (2 panels) ----
p_lin <- ggplot(p_long, aes(x = method, y = p)) +
  geom_boxplot(outlier.alpha = 0.25) +
  facet_grid(test ~ method, scales = "free_y") +
  labs(x = NULL, y = "p-value", title = "P-value distributions (Permutation vs BOOTEI)") +
  theme_classic(base_size = 12) +
  theme(
    strip.background = element_blank(),
    strip.text = element_text(face = "bold"),
    axis.text.x = element_text(angle = 0),
    plot.title = element_text(face = "bold", hjust = 0)
  )

p_log <- ggplot(p_long, aes(x = method, y = p)) +
  geom_boxplot(outlier.alpha = 0.25) +
  facet_grid(test ~ method, scales = "free_y") +
  scale_y_log10() +
  labs(x = NULL, y = "p-value (log10)", title = "P-value distributions (log scale)") +
  theme_classic(base_size = 12) +
  theme(
    strip.background = element_blank(),
    strip.text = element_text(face = "bold"),
    axis.text.x = element_text(angle = 0),
