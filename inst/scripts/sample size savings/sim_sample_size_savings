## -------------------- EXPAND TO RAW 2x2 COMBINATIONS -------------
## Create all natural contrasts: 0 ppm vs 300/1000/3000 ppm

expand_endpoint_to_contrasts <- function(row_df) {
  stopifnot(nrow(row_df) == 1L)
  r <- row_df[1, , drop = FALSE]
  
  dose_levels <- c(300L, 1000L, 3000L)
  x_treated   <- c(r$x300, r$x1000, r$x3000)
  n_treated   <- c(r$n300, r$n1000, r$n3000)
  
  tibble(
    endpoint_id    = r$endpoint_id,
    species        = r$species,
    sex            = r$sex,
    organ          = r$organ,
    endpoint       = r$endpoint,
    endpoint_class = r$endpoint_class,
    count_source   = r$count_source,
    dose_ppm       = dose_levels,
    x0             = as.integer(rep(r$x0, 3)),
    n0             = as.integer(rep(r$n0, 3)),
    x1             = as.integer(x_treated),
    n1             = as.integer(n_treated)
  )
}

raw_scenarios <- bind_rows(lapply(seq_len(nrow(endpoints_wide)), function(i) {
  expand_endpoint_to_contrasts(endpoints_wide[i, , drop = FALSE])
})) %>%
  mutate(
    p0_obs = x0 / n0,
    p1_obs = x1 / n1,
    effect_direction = case_when(
      p1_obs > p0_obs ~ "increase",
      p1_obs < p0_obs ~ "decrease",
      TRUE            ~ "same"
    ),
    degenerate_obs = (x0 + x1 == 0L) | (x0 + x1 == (n0 + n1)),
    table_key = paste(x0, n0, x1, n1, sep = "_"),
    combo_label = paste0(
      sex, " ", species, " – ", organ, " – ", endpoint,
      " [", endpoint_class, "], 0 vs ", dose_ppm, " ppm: ",
      x0, "/", n0, " vs ", x1, "/", n1,
      " (", effect_direction, ")"
    ),
    source = paste0("Furukawa et al. 2024, ", count_source, ".")
  )

## -------------------- FILTER DEGENERATE + COLLAPSE DUPLICATES ----
## Keep all valid (non-degenerate) observed 2x2 tables, then collapse exact
## duplicate count tables to avoid redundant simulation scenarios.

scenarios <- raw_scenarios %>%
  filter(!degenerate_obs) %>%
  group_by(table_key) %>%
  summarise(
    x0 = first(x0),
    n0 = first(n0),
    x1 = first(x1),
    n1 = first(n1),
    
    n_raw_combinations = n(),
    dose_ppm_levels = paste(sort(unique(dose_ppm)), collapse = ","),
    endpoint_classes = paste(sort(unique(endpoint_class)), collapse = ", "),
    species_sex_set  = paste(unique(paste(sex, species)), collapse = " | "),
    organs           = paste(unique(organ), collapse = " | "),
    endpoints        = paste(unique(endpoint), collapse = " | "),
    combo_members    = paste(combo_label, collapse = " || "),
    source           = paste(unique(source), collapse = " || "),
    repr_combo       = first(combo_label),
    
    ## Anchors to observed data
    p0 = x0 / n0,
    p1 = x1 / n1,
    p_pool = (x0 + x1) / (n0 + n1),
    
    ## Keep OR as a descriptive statistic only (not used by the DGP)
    or_hat = ((x1 + 0.5) * ((n0 - x0) + 0.5)) /
      (((n1 - x1) + 0.5) * (x0 + 0.5)),
    
    .groups = "drop"
  ) %>%
  mutate(
    label = paste0(
      "Observed unique 2x2: 0 ppm ", x0, "/", n0,
      " vs dose ", x1, "/", n1,
      " (dose levels represented: {", dose_ppm_levels, "})"
    ),
    combo_brief = ifelse(
      n_raw_combinations == 1L,
      repr_combo,
      paste0("Collapses ", n_raw_combinations,
             " identical study combinations: ", combo_members)
    ),
    rank = row_number(),
    case_id = row_number(),
    test = "chisq"
  ) %>%
  arrange(case_id)

## Build a transparent raw catalogue (anti-cherry-picking audit trail)
raw_catalogue <- raw_scenarios %>%
  left_join(
    scenarios %>% select(case_id, table_key),
    by = "table_key"
  ) %>%
  mutate(
    kept_for_sim = !degenerate_obs & !is.na(case_id),
    exclusion_reason = case_when(
      degenerate_obs ~ "observed_degenerate_all0_or_all1",
      !degenerate_obs & duplicated(table_key) ~ "exact_duplicate_2x2_collapsed",
      TRUE ~ "kept"
    )
  ) %>%
  arrange(species, sex, organ, endpoint, dose_ppm)

## -------------------- FIXED-MARGINS LINEAR-BY-LINEAR DRAW (2x2) ---
## Model: P(A=a | n,n,m,theta) ∝ choose(n,a) * choose(n,m-a) * exp(theta*a)
## Here omega = exp(theta). We calibrate theta so that E[A] ≈ n*p1.

rFisherNoncentral_2x2 <- function(n, m, omega, seed) {
  set.seed(seed)
  
  lo <- max(0L, m - n)
  hi <- min(n, m)
  if (lo > hi) stop("Infeasible margins: check n and m")
  
  a_vals <- lo:hi
  lw <- lchoose(n, a_vals) + lchoose(n, m - a_vals) + a_vals * log(omega)
  lw <- lw - max(lw)
  w  <- exp(lw)
  p  <- w / sum(w)
  
  sample(a_vals, size = 1L, prob = p)
}

## Compute E[A] under the 2x2 conditional (noncentral hypergeometric) model
EA_noncentral_2x2 <- function(n, m, log_omega) {
  lo <- max(0L, m - n)
  hi <- min(n, m)
  a_vals <- lo:hi
  
  lw <- lchoose(n, a_vals) + lchoose(n, m - a_vals) + a_vals * log_omega
  lw <- lw - max(lw)
  w  <- exp(lw)
  p  <- w / sum(w)
  
  sum(a_vals * p)
}

## Calibrate omega so that E[A] ~= mu_target, using a monotone bisection on log(omega)
omega_from_target_mean_2x2 <- function(n, m, mu_target,
                                       log_omega_lo = -20, log_omega_hi = 20,
                                       tol = 1e-6, maxit = 60) {
  lo <- max(0L, m - n)
  hi <- min(n, m)
  
  ## clamp target to support
  mu_target <- max(lo, min(hi, mu_target))
  
  f_lo <- EA_noncentral_2x2(n, m, log_omega_lo) - mu_target
  f_hi <- EA_noncentral_2x2(n, m, log_omega_hi) - mu_target
  
  ## if target achieved only at extremes (numerically), return the extreme
  if (f_lo >= 0) return(exp(log_omega_lo))
  if (f_hi <= 0) return(exp(log_omega_hi))
  
  for (it in seq_len(maxit)) {
    mid <- 0.5 * (log_omega_lo + log_omega_hi)
    f_mid <- EA_noncentral_2x2(n, m, mid) - mu_target
    if (abs(f_mid) < tol) return(exp(mid))
    if (f_mid > 0) {
      log_omega_hi <- mid
    } else {
      log_omega_lo <- mid
    }
  }
  exp(0.5 * (log_omega_lo + log_omega_hi))
}

## Data-anchored fixed-margins draw:
##   m(n) = round((p0+p1)*n), omega calibrated so E[A] ~ n*p1
draw_fixed_margins_lxl_2x2 <- function(p0, p1, n, seed) {
  set.seed(seed)
  
  m <- as.integer(round((p0 + p1) * n))
  m <- max(0L, min(2L * n, m))
  
  if (m == 0L || m == 2L * n) {
    return(list(degenerate = TRUE, x = NULL, y = NULL, n = n, m = m, omega = NA_real_))
  }
  
  mu_target <- n * p1
  omega <- omega_from_target_mean_2x2(n = n, m = m, mu_target = mu_target)
  
  a <- rFisherNoncentral_2x2(n = n, m = m, omega = omega, seed = seed + 17L)
  
  s0 <- m - a  ## control events
  s1 <- a      ## treated events
  
  x <- factor(c(rep("C", n), rep("T", n)), levels = c("C","T"))
  y <- factor(c(rep("1", s0), rep("0", n - s0),
                rep("1", s1), rep("0", n - s1)),
              levels = c("0","1"))
  
  list(degenerate = FALSE, x = x, y = y, n = n, m = m, omega = omega)
}

power_at_n_fixed_lxl <- function(p0, p1, n, alpha, MC, R, B, seed_base) {
  rej_perm <- 0L
  rej_bt   <- 0L
  
  for (r in seq_len(MC)) {
    dat <- draw_fixed_margins_lxl_2x2(p0 = p0, p1 = p1, n = n, seed = seed_base + 1009L * r)
    
    if (isTRUE(dat$degenerate)) {
      ## keep replicate; non-informative -> no rejection
      next
    }
    
    p_perm <- bootei_safe_p(dat$x, dat$y, B = 1L, R = R, seed = seed_base + 2009L * r)
    p_bt   <- bootei_safe_p(dat$x, dat$y, B = B,  R = R, seed = seed_base + 2009L * r)
    
    if (!is.na(p_perm)) rej_perm <- rej_perm + as.integer(p_perm <= alpha)
    if (!is.na(p_bt))   rej_bt   <- rej_bt   + as.integer(p_bt   <= alpha)
  }
  
  c(pow_perm = rej_perm / MC, pow_bt = rej_bt / MC)
}

## -------------------- CHUNKED TASK (PARALLEL UNIT) ---------------

case_chunk_task_fixed <- function(case_id, row, n_vec,
                                  alpha, MC_per_n, R_power, B_power) {
  pin_threads()
  row <- row[1, , drop = FALSE]
  
  out <- vector("list", length(n_vec))
  for (k in seq_along(n_vec)) {
    n <- as.integer(n_vec[k])
    
    ## deterministic seed per (case_id, n)
    sb <- 10000L + as.integer(case_id) * 100000L + n
    
    pw <- power_at_n_fixed_lxl(
      p0      = row$p0,
      p1      = row$p1,
      n       = n,
      alpha   = alpha,
      MC      = MC_per_n,
      R       = R_power,
      B       = B_power,
      seed_base = sb
    )
    
    out[[k]] <- tibble(
      case_id  = as.integer(case_id),
      n        = n,
      pow_perm = unname(pw["pow_perm"]),
      pow_bt   = unname(pw["pow_bt"])
    )
  }
  
  bind_rows(out)
}

