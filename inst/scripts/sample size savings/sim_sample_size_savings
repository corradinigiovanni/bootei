## -------------------- RECONSTRUCT TARGET n PER CASE --------------

savings <- pow_tbl %>%
  group_by(case_id) %>%
  summarise(
    n_perm_target = {
      idx <- which(pow_perm >= power_target)
      if (length(idx)) min(n[idx]) else NA_integer_
    },
    n_bootei_target = {
      idx <- which(pow_bt >= power_target)
      if (length(idx)) min(n[idx]) else NA_integer_
    },
    reached_perm   = any(pow_perm >= power_target, na.rm = TRUE),
    reached_bootei = any(pow_bt   >= power_target, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    saved_n = ifelse(is.na(n_perm_target) | is.na(n_bootei_target),
                     NA_integer_, n_perm_target - n_bootei_target),
    saved_frac = ifelse(is.na(n_perm_target) | is.na(n_bootei_target) | n_perm_target == 0,
                        NA_real_, (n_perm_target - n_bootei_target) / n_perm_target),
    max_n_grid = max(n_grid)
  )

final_tbl <- scenarios %>%
  left_join(savings, by = "case_id") %>%
