# ------------------ Axis label formatter ------------------
label_pvalue_jrssb <- function(x) {
  out <- ifelse(
    abs(x - 0) < 1e-10, "0",
    ifelse(
      abs(x - 1) < 1e-10, "1",
      sprintf("%.2f", x)
    )
  )
  out
}

# ------------------ Theme ------------------
theme_jrssb_ecdf_panel <- function(base_size = 11,
                                   show_x = TRUE,
                                   show_y = TRUE,
                                   tag_y = 1.03) {
  
  th <- theme_classic(base_size = base_size) +
    theme(
      panel.grid = element_blank(),
      axis.line  = element_line(linewidth = 0.4, colour = "black"),
      axis.ticks = element_line(linewidth = 0.4, colour = "black"),
      axis.ticks.length = grid::unit(0.14, "cm"),
      
      axis.text.x = element_text(size = base_size - 1),
      axis.text.y = element_text(size = base_size - 1),
      
      axis.title.x = element_blank(),
      axis.title.y = element_blank(),
      
      plot.title = element_blank(),
      plot.subtitle = element_text(
        size = base_size,
        hjust = 0.5,
        margin = margin(b = 4)
      ),
      
      plot.tag = element_text(size = base_size + 1, face = "bold"),
      plot.tag.position = c(0.01, tag_y),
      
      legend.position = "none",
      plot.margin = margin(10, 4, 5, 4)
    )
  
  if (!show_x) {
    th <- th + theme(
      axis.text.x  = element_blank(),
      axis.ticks.x = element_blank()
    )
  }
  
  if (!show_y) {
    th <- th + theme(
      axis.text.y  = element_blank(),
      axis.ticks.y = element_blank()
    )
  }
  
  th
}

# ------------------ Single-panel function ------------------
make_ecdf_panel_chi2_compare_dgp1 <- function(df_data,
                                              p_col,
                                              panel_label,
                                              panel_tag,
                                              show_x = TRUE,
                                              show_y = TRUE,
                                              tag_y = 1.03,
                                              base_size = 11) {
  
  d <- df_data %>%
    transmute(p = .data[[p_col]]) %>%
    filter(is.finite(p), !is.na(p), p >= 0, p <= 1)
  
  ggplot(d, aes(x = p)) +
    stat_ecdf(
      linewidth = 0.80,
      colour = "black"
    ) +
    geom_abline(
      intercept = 0,
      slope = 1,
      linetype = "dotted",
      linewidth = 0.75,
      colour = "grey35"
    ) +
    scale_x_continuous(
      limits = c(0, 1),
      breaks = c(0, 0.25, 0.50, 0.75, 1.00),
      labels = label_pvalue_jrssb,
      expand = expansion(mult = c(0, 0))
    ) +
    scale_y_continuous(
      limits = c(0, 1),
      breaks = c(0, 0.25, 0.50, 0.75, 1.00),
      labels = label_number(accuracy = 0.01),
      expand = expansion(mult = c(0, 0))
    ) +
    coord_cartesian(expand = FALSE) +
    labs(
      subtitle = panel_label,
      tag = panel_tag
    ) +
    theme_jrssb_ecdf_panel(
      base_size = base_size,
      show_x = show_x,
      show_y = show_y,
      tag_y = tag_y
    )
}

