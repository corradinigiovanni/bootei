cat("\n================ MEAN SIZE (H0) & MEAN POWER (H1) ==============\n")
print(mean_rates, n = Inf)


# --------------------------- OUTPUT ----------------------------

cat("\n================ TABLES  ===================\n")
cat("\n-- Mean rates (size/power):\n")
print(mean_rates, n = Inf)

cat("\n-- H0 size tests (binom.test):\n")
print(H0_tests %>%
