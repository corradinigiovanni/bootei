# ================================================================
# χ² (n=10, 2x2, DGP1) – analysis of chi2_N10_COMPARE_DETAIL_GLOBAL_dgp1.csv
#   - Size (H0) and Power (H1) for: Perm, mid-p, BOOTEI, Randomized, χ²(asym), Fisher
#   - McNemar tests under H1 (paired, one-sided comparisons)
#   - Size tests under H0: binom.test vs alpha (NO BH: single scenario)
#   - Extra table: mean size & mean power by method
#   - Plots (2 panels): H0 ECDF vs Uniform + H0 density vs Uniform (y=1)
# ================================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(tidyr)
  library(readr)
  library(tibble)
  library(ggplot2)
  library(scales)
  library(glue)
  library(conflicted)
  library(patchwork)
  library(cowplot)
})

conflict_prefer("select", "dplyr")
conflict_prefer("filter", "dplyr")
conflict_prefer("mutate", "dplyr")

# ---------------------------- PATH -----------------------------

ROOT <- "."
file_global <- file.path(ROOT, "chi2_N10_COMPARE_DETAIL_GLOBAL_dgp1.csv")
stopifnot("chi2_N10_COMPARE_DETAIL_GLOBAL_dgp1.csv not found!" = file.exists(file_global))

# -------------------------- LOAD DATA --------------------------

chi2_all <- read_csv(file_global, show_col_types = FALSE) %>%
  mutate(
    n     = as.integer(n),
    k_row = as.integer(k_row),
    k_col = as.integer(k_col),
    rep   = as.integer(rep),
    sim_in_rep = as.integer(sim_in_rep)
  )

alpha_nominal <- chi2_all$alpha %>% unique() %>% sort() %>% tail(1)
cat(glue("Nominal alpha: {alpha_nominal}\n"))

# --------------------- CELL SUMMARY (H0/H1) --------------------

chi2_summary <- chi2_all %>%
  group_by(scenario, n, k_row, k_col, alpha, theta) %>%
  summarise(
    total_sim = n(),
    
    rej_perm   = sum(sig_perm,   na.rm = TRUE),
    rej_midp   = sum(sig_midp,   na.rm = TRUE),
    rej_bootei = sum(sig_bootei, na.rm = TRUE),
    rej_rand   = sum(sig_rand,   na.rm = TRUE),
    rej_asym   = sum(sig_asym,   na.rm = TRUE),
    rej_fisher = sum(sig_fisher, na.rm = TRUE),
    
    rate_perm   = rej_perm   / total_sim,
    rate_midp   = rej_midp   / total_sim,
    rate_bootei = rej_bootei / total_sim,
    rate_rand   = rej_rand   / total_sim,
    rate_asym   = rej_asym   / total_sim,
    rate_fisher = rej_fisher / total_sim,
    .groups = "drop"
  )

cat("\n================ SUMMARY (rates at alpha) ======================\n")
print(chi2_summary, n = Inf)

# ---------------------- MCNEMAR TESTS (H1) ---------------------

mcnemar_binom <- function(b, c) {
  disc <- b + c
  if (disc <= 0) return(1.0)
  pbinom(b - 1, disc, 0.5, lower.tail = FALSE)  # one-sided: method1 > method2
}

mcnemar_block <- function(df, m1, m2, lab1, lab2) {
  s1 <- df[[m1]]
  s2 <- df[[m2]]
  a <- sum(s1 & s2,  na.rm = TRUE)
  b <- sum(s1 & !s2, na.rm = TRUE)
  c <- sum(!s1 & s2, na.rm = TRUE)
  d <- sum(!s1 & !s2,na.rm = TRUE)
  tibble(
    total_sim = nrow(df),
    method1 = lab1,
    method2 = lab2,
    rate1   = mean(s1, na.rm = TRUE),
    rate2   = mean(s2, na.rm = TRUE),
    a = a, b = b, c = c, d = d,
    p_mcn_1gt2 = mcnemar_binom(b, c),
    p_mcn_2gt1 = mcnemar_binom(c, b),
    diff_rate  = mean(s1, na.rm = TRUE) - mean(s2, na.rm = TRUE)
  )
}

df_H1 <- chi2_all %>% filter(grepl("H1", scenario))

H1_mcnemar_tbl <- bind_rows(
  mcnemar_block(df_H1, "sig_bootei", "sig_perm", "BOOTEI", "Perm"),
  mcnemar_block(df_H1, "sig_bootei", "sig_midp", "BOOTEI", "mid-p"),
  mcnemar_block(df_H1, "sig_bootei", "sig_rand", "BOOTEI", "Randomized"),
  mcnemar_block(df_H1, "sig_bootei", "sig_asym", "BOOTEI", "ChiSq-asym"),
  mcnemar_block(df_H1, "sig_bootei", "sig_fisher", "BOOTEI", "Fisher")
)

cat("\n================ MCNEMAR (H1, one-sided) =======================\n")
print(H1_mcnemar_tbl, n = Inf)

# -------------------- SIZE TESTS (H0): binom.test ---------------

df_H0 <- chi2_all %>% filter(grepl("H0", scenario))

h0_rej <- tibble(
  method = c("Perm", "mid-p", "BOOTEI", "Randomized", "ChiSq-asym", "Fisher"),
  rej = c(
    sum(df_H0$sig_perm,   na.rm = TRUE),
    sum(df_H0$sig_midp,   na.rm = TRUE),
    sum(df_H0$sig_bootei, na.rm = TRUE),
    sum(df_H0$sig_rand,   na.rm = TRUE),
    sum(df_H0$sig_asym,   na.rm = TRUE),
    sum(df_H0$sig_fisher, na.rm = TRUE)
  ),
  total_sim = nrow(df_H0),
  alpha = alpha_nominal
)

binom_tests_row <- function(rej, tot, alpha) {
  bt_two <- binom.test(rej, tot, p = alpha, alternative = "two.sided")
  tibble(
    size_hat = rej / tot,
    p_two     = bt_two$p.value,
    ci_lo     = unname(bt_two$conf.int[1]),
    ci_hi     = unname(bt_two$conf.int[2]),
    p_greater = binom.test(rej, tot, p = alpha, alternative = "greater")$p.value,
    p_less    = binom.test(rej, tot, p = alpha, alternative = "less")$p.value
  )
}

H0_tests <- h0_rej %>%
  rowwise() %>%
  mutate(tmp = list(binom_tests_row(rej, total_sim, alpha))) %>%
  unnest(cols = c(tmp)) %>%
  ungroup() %>%
  mutate(
    size_flag = case_when(
      p_greater < 0.05 ~ "↑ (size > α)",
      p_less    < 0.05 ~ "↓ (size < α)",
      TRUE             ~ "OK"
    )
  ) %>%
  arrange(factor(method, levels = c("Perm","mid-p","BOOTEI","Randomized","ChiSq-asym","Fisher")))

cat("\n================ SIZE TESTS (H0): binom.test ===================\n")
print(H0_tests, n = Inf)

# -------------------- EXTRA TABLE: MEAN SIZE & POWER -------------

mean_rates <- tibble(
